# Copiar a .env solo si ejecutas la API en el host (fuera de Compose).
# Dentro de Compose estas variables ya vienen definidas en docker-compose.yml,
# con hostnames de servicio (postgres, redis) en lugar de localhost.

APP_NAME=Coreway AI Gateway
APP_ENV=local
LOG_LEVEL=INFO
API_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://coreway:coreway@localhost:5432/coreway
REDIS_URL=redis://localhost:6379/0
AI_PROVIDER=local
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_RECOVERY_SECONDS=15
AI_RETRY_ATTEMPTS=2
